# ============================================================
# Marketplace Lister — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3001
# Public URL for serving images (needed for eBay API image links)
# For local use, you can use ngrok: ngrok http 3001
PUBLIC_URL=http://localhost:3001

# --- AI (Claude API) ---
# Get your key from: https://console.anthropic.com
# NOTE: Your Claude Pro subscription cannot be used for API access — this is a separate billing key.
# Alternative: swap for Gemini (free tier) — see README for instructions.
ANTHROPIC_API_KEY=

# --- eBay ---
# Create an app at: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SANDBOX_MODE=true          # Set to false for production
EBAY_MARKETPLACE_ID=EBAY_US
# Required for publishing offers (set up in eBay Seller Hub):
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# --- Facebook Marketplace ---
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# --- Craigslist ---
# Your city's Craigslist subdomain (e.g., sfbay, chicago, newyork, losangeles)
CRAIGSLIST_CITY=sfbay
# Email used for Craigslist postings (can be your Gmail)
CRAIGSLIST_EMAIL=
# Optional: your zip code for Craigslist location field
POSTAL_CODE=

# --- Google (Gmail + Calendar) ---
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API, Google Calendar API
# Set redirect URI to: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Your Gmail address (for sending Craigslist replies via Gmail API)
GMAIL_USER=

# Where to send meetup alert emails (can be same as GMAIL_USER)
USER_NOTIFY_EMAIL=

# --- Notion Database ---
# 1. Create a Notion integration at: https://www.notion.so/my-integrations
#    Give it "Read content", "Update content", "Insert content" capabilities.
# 2. Create a blank Notion page, share it with your integration ("Full access").
# 3. Copy the page ID from the URL and paste below.
# 4. Run: npm run setup:notion
#    This creates all 7 databases and prints their IDs — paste them below.
NOTION_TOKEN=secret_xxxx
NOTION_PARENT_PAGE_ID=

# Filled in automatically by: npm run setup:notion
NOTION_LISTINGS_DB=
NOTION_PHOTOS_DB=
NOTION_PLATFORM_LISTINGS_DB=
NOTION_THREADS_DB=
NOTION_MESSAGES_DB=
NOTION_MEETINGS_DB=
NOTION_SETTINGS_DB=
