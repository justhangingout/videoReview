# Charles Schwab Developer API credentials
# Register at: https://developer.schwab.com
# Callback URL must match exactly: http://127.0.0.1:3001/callback
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=http://127.0.0.1:3001/callback

# Anthropic API key for Claude LLM signal validation
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Set to true to log orders without sending them to Schwab (safe for testing)
PAPER_TRADING=false

# Log verbosity: info | debug
LOG_LEVEL=info
